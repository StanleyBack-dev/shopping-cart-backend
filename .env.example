# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL). For local development via docker-compose:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopping_cart?schema=public"
# For Neon, use the pooled connection string Neon gives you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shopping_cart?schema=public"

# CORS: comma-separated list of allowed origins for the frontend
FRONTEND_URL="http://localhost:3001"
